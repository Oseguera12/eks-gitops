# ─── AWS ──────────────────────────────────────────────────────────────────────
# Your AWS account and target region
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# ─── GitHub OIDC ──────────────────────────────────────────────────────────────
# Used in Terraform to scope the OIDC trust policy to this repository
GITHUB_REPO_OWNER=Oseguera12
GITHUB_REPO_NAME=eks-gitops

# ─── Terraform State Backend ──────────────────────────────────────────────────
# Create these resources ONCE manually before running `terraform init`.
# See bootstrap/README.md for the exact AWS CLI commands.
TF_STATE_BUCKET=eks-gitops-tfstate-<your-account-id>
TF_STATE_DYNAMODB_TABLE=eks-gitops-tfstate-lock
TF_STATE_KEY=eks-gitops/terraform.tfstate

# ─── Cluster ──────────────────────────────────────────────────────────────────
CLUSTER_NAME=eks-gitops
CLUSTER_VERSION=1.32
NODE_INSTANCE_TYPE=t3.medium
NODE_MIN_SIZE=1
NODE_DESIRED_SIZE=2
NODE_MAX_SIZE=3

# ─── ArgoCD ───────────────────────────────────────────────────────────────────
# Set in GitHub Actions secrets, not locally
# ARGOCD_SERVER=argocd.example.com
# ARGOCD_AUTH_TOKEN=<token>

# ─── Cosign ───────────────────────────────────────────────────────────────────
# Keyless signing via Sigstore — no key material needed
# COSIGN_EXPERIMENTAL=1 is set in the workflow automatically
